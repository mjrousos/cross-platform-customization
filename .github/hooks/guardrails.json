{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "mkdir -p logs && echo 'Pre-tool-use hook' >> logs/session.log",
        "powershell": "New-Item -ItemType Directory -Path logs -Force | Out-Null; Add-Content -Path logs/session.log -Value \"Pre-Tool Use with cwd $PWD\"",
        "cwd": ".github/hooks",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "./scripts/url-allowlist.sh",
        "powershell": "./scripts/url-allowlist.ps1",
        "cwd": ".github/hooks",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "./scripts/rm-confirm.sh",
        "powershell": "./scripts/rm-confirm.ps1",
        "cwd": ".github/hooks",
        "timeoutSec": 300
      }
    ]
  }
}
